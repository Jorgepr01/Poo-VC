# GitHub Linguist overrides: Prioritize Core Java Engine in repository language statistics

# Exclude Gradle Kotlin DSL configuration scripts
*.kts linguist-detectable=false
*.kts linguist-vendored=true
*.kts linguist-generated=true

# Exclude all Kotlin presentation and wrapper files so GitHub highlights the Java core engine
*.kt linguist-detectable=false
*.kt linguist-vendored=true
*.kt linguist-generated=true

